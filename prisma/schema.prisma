generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── User Model ───────────────────────────────────────────────
model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  password        String
  image           String?   // Profile picture URL
  // Partner linking — self-relation
  partnerId       String?
  partner         User?     @relation("PartnerRelation", fields: [partnerId], references: [id])
  // Reverse lookup — users that have this user as partner
  partneredUsers  User[]    @relation("PartnerRelation")
  partnerSince    DateTime?
  partnerCode     String?   @unique
  // Web Push subscription JSON
  pushSubscription Json?
  // Notification preferences: { water: true, meal: true, love: true, mood: false }
  notificationPrefs Json?
  // Last reminder sent timestamps: { "water": "2024-01-01T10:00:00Z", ... }
  lastReminderSent Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  sentMessages     ChatMessage[] @relation("SentMessages")
  receivedMessages ChatMessage[] @relation("ReceivedMessages")
  mealLogs         MealLog[]
  moods            UserMood[]
  waterLogs        WaterLog[]
  loveNotes        LoveNote[]    @relation("UserLoveNotes")
  memories         Memory[]      @relation("UserMemories")
  sentSecretNotes     SecretNote[] @relation("SentSecretNotes")
  receivedSecretNotes SecretNote[] @relation("ReceivedSecretNotes")
  location            Location?
  locationHistory     LocationHistory[]
  geofenceZones       GeofenceZone[]
  geofenceAlerts      GeofenceAlert[]
  lovePlantsAsUser1   LovePlant[] @relation("LovePlantUser1")
  lovePlantsAsUser2   LovePlant[] @relation("LovePlantUser2")
  competitionEntriesAsUser1 CompetitionCouple[] @relation("CompetitionUser1")
  competitionEntriesAsUser2 CompetitionCouple[] @relation("CompetitionUser2")

  @@map("users")
}

// ─── Competition Badges (Rewards for leaderboard) ─────────────
model CompetitionBadge {
  id        String   @id @default(cuid())
  coupleKey String
  rank      Int      // 1, 2, 3
  title     String   // "🥇 Gold Champions", "🥈 Silver Champions", "🥉 Bronze Champions"
  weekOf    DateTime // Which week this badge was awarded
  awardedAt DateTime @default(now())

  @@unique([coupleKey, weekOf])
  @@index([coupleKey])
  @@map("competition_badges")
}

// ─── Love Plant (Co-op Health Quest) ────────────────────────────
model LovePlant {
  id        String   @id @default(cuid())
  coupleKey String   @unique // e.g. "userAid_userBid" (sorted lexicographically)
  user1Id   String
  user1     User     @relation("LovePlantUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2Id   String
  user2     User     @relation("LovePlantUser2", fields: [user2Id], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  achievements LovePlantAchievement[]
  dailySnapshots LovePlantDailySnapshot[]

  @@map("love_plants")
}

// ─── Love Plant Daily Snapshots (cached health history) ────────────
model LovePlantDailySnapshot {
  id        String   @id @default(cuid())
  coupleKey String
  lovePlant LovePlant @relation(fields: [coupleKey], references: [coupleKey], onDelete: Cascade)
  date      DateTime   // midnight UTC of the snapshot day
  health    Int        // 0-100 combined health score
  user1Water Int @default(0)
  user1Meals Int @default(0)
  user2Water Int @default(0)
  user2Meals Int @default(0)
  createdAt DateTime @default(now())

  @@unique([coupleKey, date])
  @@index([coupleKey, date])
  @@map("love_plant_daily_snapshots")
}

// ─── Competition / Leaderboard ────────────────────────────────
model Competition {
  id        String   @id @default(cuid())
  name      String   @default("Love Plant League")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  couples CompetitionCouple[]

  @@map("competitions")
}

model CompetitionCouple {
  id            String   @id @default(cuid())
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  coupleKey     String   @unique // same as love_plants.coupleKey
  teamName      String?  // Final agreed team name
  nameSuggestedByUser1 String?  // name suggested by user1
  nameSuggestedByUser2 String?  // name suggested by user2
  user1Id       String
  user1         User     @relation("CompetitionUser1", fields: [user1Id], references: [id])
  user2Id       String
  user2         User     @relation("CompetitionUser2", fields: [user2Id], references: [id])
  user1Agreed   Boolean  @default(false)
  user2Agreed   Boolean  @default(false)
  joinedAt      DateTime @default(now())

  @@index([competitionId])
  @@index([coupleKey])
  @@map("competition_couples")
}

// ─── Love Plant Achievements ────────────────────────────────────
model LovePlantAchievement {
  id        String   @id @default(cuid())
  coupleKey String
  lovePlant LovePlant @relation(fields: [coupleKey], references: [coupleKey], onDelete: Cascade)
  type      String   // "first_bloom" | "three_day_streak" | "seven_day_streak" | "perfect_week" | "water_warriors" | "meal_masters"
  awardedAt DateTime @default(now())

  @@unique([coupleKey, type])
  @@index([coupleKey])
  @@map("love_plant_achievements")
}

// ─── Live Location Tracking ────────────────────────────────────
model Location {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  latitude  Float
  longitude Float
  accuracy  Float?       // meters
  speed     Float?       // m/s
  heading   Float?       // degrees
  isSharing Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@map("locations")
}

// ─── Geofence Zones (Home, Office, etc.) ────────────────────────
model GeofenceZone {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String   // "Home", "Office", "Gym"
  latitude  Float
  longitude Float
  radius    Float    @default(200) // in meters
  color     String   @default("#f43f5e")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  alerts GeofenceAlert[]

  @@index([userId, enabled])
  @@map("geofence_zones")
}

// ─── Geofence Alerts (entry/exit events) ───────────────────────
model GeofenceAlert {
  id            String   @id @default(cuid())
  zoneId        String
  zone          GeofenceZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  ownerId       String        // The user who OWNS the zone (gets notified)
  owner         User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  partnerUserId String        // The user who entered/exited
  eventType     String        // "ENTERED" | "EXITED"
  latitude      Float
  longitude     Float
  createdAt     DateTime @default(now())

  @@index([zoneId, partnerUserId, createdAt])
  @@index([ownerId, createdAt])
  @@map("geofence_alerts")
}

// ─── Location History (movement trail / timeline) ──────────────
model LocationHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  latitude  Float
  longitude Float
  accuracy  Float?       // meters
  speed     Float?       // m/s
  heading   Float?       // degrees
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("location_history")
}

// ─── Memories ────────────────────────────────────────────────
model Memory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("UserMemories", fields: [userId], references: [id])
  imageUrl  String
  caption   String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  @@map("memories")
}

// ─── Secret Love Notes ───────────────────────────────────────
model SecretNote {
  id         String   @id @default(cuid())
  senderId   String
  sender     User     @relation("SentSecretNotes", fields: [senderId], references: [id])
  receiverId String
  receiver   User     @relation("ReceivedSecretNotes", fields: [receiverId], references: [id])
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@map("secret_notes")
}

// ─── Love Notes ───────────────────────────────────────────────
model LoveNote {
  id        String   @id @default(cuid())
  content   String
  authorId  String?  // Optional: if partners write to each other
  author    User?    @relation("UserLoveNotes", fields: [authorId], references: [id])
  isSystem  Boolean  @default(true) // If true, it's a daily auto-generated note
  displayAt DateTime @default(now()) // When this note should be shown
  createdAt DateTime @default(now())

  @@map("love_notes")
}

// ─── Chat Messages ────────────────────────────────────────────
model ChatMessage {
  id         String    @id @default(cuid())
  senderId   String?   // Nullable for AI assistant
  sender     User?     @relation("SentMessages", fields: [senderId], references: [id])
  receiverId String?   // Nullable for AI chat
  receiver   User?     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  role       String    // "user" | "assistant" | "partner"
  content    String
  readAt     DateTime? // When the receiver viewed this message (null = unread)
  createdAt  DateTime  @default(now())

  @@index([receiverId, readAt])
  @@map("chat_messages")
}

// ─── Verification Codes (OTP) ────────────────────────────────
model VerificationCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@map("verification_codes")
}

// ─── Meal Logs ────────────────────────────────────────────────
model MealLog {
  id          String   @id @default(cuid())
  userId      String?  // Nullable for backward compatibility
  user        User?    @relation(fields: [userId], references: [id])
  mealName    String
  ingredients String   // Comma-separated or JSON string
  isOutside   Boolean  @default(false)
  cost        Float?
  notes       String?
  createdAt   DateTime @default(now())

  @@map("meal_logs")
}

// ─── User Moods ───────────────────────────────────────────────
model UserMood {
  id        String   @id @default(cuid())
  userId    String?  // Nullable for backward compatibility
  user      User?    @relation(fields: [userId], references: [id])
  mood      String   // "happy" | "stressed" | "tired" | "productive"
  note      String?
  createdAt DateTime @default(now())

  @@map("user_moods")
}

// ─── Water Logs ───────────────────────────────────────────────
model WaterLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  date      DateTime // Date portion only (normalized to midnight)
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@map("water_logs")
}
